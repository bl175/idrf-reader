# IDRF Reader settings. Copy this file to .env and edit it.
# The .env file is never committed to git (see .gitignore).

# Password of the "admin" coordinator account. Change it before the first start.
ADMIN_PASSWORD=CHANGE-THIS-PASSWORD

# Where the app listens.
# 127.0.0.1 = this computer only (testing).
# 0.0.0.0   = other computers on the network can open it (hospital server).
HOST=127.0.0.1
PORT=8080

# Folder for images, database and prepared cache. Relative paths start at the project folder.
DATA_DIR=data

# How long a sign-in lasts, in hours.
SESSION_HOURS=12

# Largest in-plane image size sent to browsers. 512 keeps full CT resolution;
# 256 makes loading four times lighter on a slow network.
MAX_INPLANE=512

# Slice thickness in mm preferred when a study holds several contrast series.
PREFERRED_THICKNESS=2.5

# Set to 1 once the app is served over HTTPS (behind the hospital's reverse proxy).
COOKIE_SECURE=0

# Optional: DICOM studies in Azure Blob Storage, laid out as <prefix>/<patient>/<study>/<series>/<files>.
# When set, the coordinator page lists the studies so the coordinator can pick which become cases.
# Use the storage account's connection string, or a read-only SAS connection string.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=
